// Full-stack Todo: UI, data model and HTTP API in one source file.
app TodoApp {
  model Todo {
    id: int primary
    title: string
    done: bool = false
  }

  api "/todos" {
    list Todo
    create Todo
  }

  api "/todos/:id" {
    get Todo
    update Todo
    delete Todo
  }

  state remaining = 0

  theme { mode: light, accent: "#097FEB", radius: 14 }

  Column(p: 14, gap: 10) {
    Container(p: 16, rounded: 16, shadow: 4, gradient: "#097FEB,#043B70", animate: ease) {
      Text("OPUROM Todo", size: 20, color: "#FFFFFF")
      Text("UI, model and API in one source file", size: 11, color: "#D6E8FF")
    }
    Container(p: 14, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
      Text("Remaining", size: 11, color: "#667085")
      Text("{remaining}", size: 30, color: "#097FEB")
    }
    Container(p: 10, rounded: 14, shadow: 3, bg: "#F4F7FB") {
      Row(gap: 10, bg: "#F4F7FB") {
        Button("Refresh", p: 10, rounded: 10, shadow: 2, bg: "#097FEB", fontScale: 1.0, animate: spring) {
          remaining += 1
        }
      }
    }
  }
}
