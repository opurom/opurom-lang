// Full-stack Todo: UI, data model and HTTP API in one source file.
app TodoApp {
  model Todo {
    id: int primary
    title: string
    done: bool = false
  }

  api "/todos" {
    list Todo
    create Todo
  }

  api "/todos/:id" {
    get Todo
    update Todo
    delete Todo
  }

  state remaining = 0

  theme { mode: light, accent: "#097FEB", radius: 14 }

  Column(p: 24, gap: 20) {
    Container(p: 26, rounded: 18, shadow: 4, gradient: "#097FEB,#043B70", animate: ease) {
      Text("OPUROM Todo", size: 28, color: "#FFFFFF")
      Text("UI, model and API in one source file", size: 13, color: "#D6E8FF")
    }
    Container(p: 24, rounded: 16, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
      Column(gap: 8) {
        Text("Remaining", size: 13, color: "#667085")
        Text("{remaining}", size: 38, color: "#097FEB")
      }
    }
    Container(p: 16, rounded: 16, shadow: 3, bg: "#F4F7FB") {
      Button("Refresh", p: 14, rounded: 14, shadow: 2, bg: "#097FEB", fontScale: 1.1, animate: spring) {
        remaining += 1
      }
    }
  }
}
